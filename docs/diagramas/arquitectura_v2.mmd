  classDef silver fill:#e8edf2,stroke:#5b6b7b,color:#1f2a35
  classDef gold fill:#fbefc4,stroke:#a07b12,color:#3d2f05
  classDef serving fill:#dcefe4,stroke:#2f7a4f,color:#123222
  classDef control fill:#ffffff,stroke:#6b7280,stroke-dasharray:4 3,color:#374151
